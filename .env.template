# ==========================================
# GMB AI Manager Environment Configuration
# ==========================================

# Active Profile
SPRING_PROFILES_ACTIVE=dev

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/gmb_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgrespassword

# Google OAuth2 Credentials
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# JWT Security Configuration
# Secret key must be a secure, random string (minimum 256 bits / 32 bytes)
JWT_SECRET=super-secure-and-very-long-jwt-signing-secret-key-32-chars-minimum

# Anthropic Claude API Configuration
# Get your API key from Anthropic Console (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key-here

# Google API Integration Mode (SANDBOX or PRODUCTION)
# Use SANDBOX to run with simulated accounts, locations, and reviews without Google verification.
# Use PRODUCTION to hit real Google Business Profile API endpoints.
GOOGLE_API_MODE=SANDBOX

# App URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
