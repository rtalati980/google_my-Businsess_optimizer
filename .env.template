# ==========================================
# GMB AI Manager Environment Configuration
# ==========================================
# This template supports multiple environments: dev, staging, and production
# Copy this file to .env and customize for your environment

# ==========================================
# GENERAL CONFIGURATION
# ==========================================

# Active Spring Profile (dev, staging, prod)
SPRING_PROFILES_ACTIVE=dev

# Node Environment (development, production)
NODE_ENV=development

# Google API Integration Mode
# - SANDBOX: Use simulated accounts and data for development/testing
# - PRODUCTION: Use real Google Business Profile API endpoints
GOOGLE_API_MODE=SANDBOX

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# MongoDB configuration (uses Docker container by default)
MONGODB_URI=mongodb://localhost:27017/gmbai
MONGODB_DATABASE=gmbai

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================

# Google OAuth2 Credentials
# Get these from: https://console.cloud.google.com/ -> APIs & Services -> Credentials
# Required scopes: email, profile, https://www.googleapis.com/auth/business.manage
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# JWT Security Configuration
# IMPORTANT: In production, generate a secure random string (minimum 32 characters)
# Use: openssl rand -base64 32
# OR: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=super-secure-and-very-long-jwt-signing-secret-key-32-chars-minimum

# ==========================================
# AI & THIRD-PARTY APIs
# ==========================================

# Anthropic Claude API Configuration
# Get your API key from: https://console.anthropic.com/
# Model should be the latest Claude model available
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Razorpay Payment Configuration (Optional)
# Get credentials from: https://dashboard.razorpay.com/
# Use 'rzp_test_*' for testing, 'rzp_live_*' for production
RAZORPAY_KEY_ID=rzp_test_mockkey
RAZORPAY_KEY_SECRET=mocksecret

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
# Gmail or other SMTP provider credentials for sending notifications
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-specific-password

# ==========================================
# APPLICATION URLs
# ==========================================

# Frontend Application URL
FRONTEND_URL=http://localhost:3000

# Backend Application URL (used by frontend for API calls)
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# ==========================================
# PRODUCTION-SPECIFIC VARIABLES
# ==========================================
# Uncomment and configure these for production deployment

# DATABASE_URL=jdbc:postgresql://your-rds-endpoint:5432/gmb_db
# DATABASE_USERNAME=your-db-username
# DATABASE_PASSWORD=your-secure-db-password
