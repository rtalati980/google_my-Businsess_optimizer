# ====================================
# AI Description Generator Configuration
# ====================================

# Select your AI Provider: anthropic, openai, gemini, groq, openrouter
AI_PROVIDER=anthropic

# Your AI API Key (depends on selected provider)
# For Anthropic: Get from https://console.anthropic.com
# For OpenAI: Get from https://platform.openai.com/api-keys
# For Gemini: Get from https://makersuite.google.com/app/apikey
# For Groq: Get from https://console.groq.com
# For OpenRouter: Get from https://openrouter.ai
AI_API_KEY=your_api_key_here

# Application URL (for referrers, redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Configuration (already configured in .env)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bizlocalpilot?retryWrites=true&w=majority

# ====================================
# Provider-Specific Settings (Optional)
# ====================================

# Anthropic Settings
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI Settings
OPENAI_MODEL=gpt-4-turbo

# Gemini Settings
GEMINI_MODEL=gemini-pro

# Groq Settings (fastest inference)
GROQ_MODEL=mixtral-8x7b-32768

# OpenRouter Settings (multi-model routing)
OPENROUTER_MODEL=anthropic/claude-3-opus

# ====================================
# Feature Flags
# ====================================
NEXT_PUBLIC_ENABLE_DESCRIPTIONS=true
NEXT_PUBLIC_MAX_GENERATIONS_PER_DAY=50
