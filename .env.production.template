# ==========================================
# GMB AI Manager - PRODUCTION Environment
# ==========================================
# This is a template for production deployment.
# DO NOT commit this file with real secrets to version control.
# Use AWS Secrets Manager, Azure Key Vault, or similar services.

# ==========================================
# GENERAL CONFIGURATION
# ==========================================
SPRING_PROFILES_ACTIVE=prod
NODE_ENV=production
GOOGLE_API_MODE=PRODUCTION

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Use managed database services (AWS RDS, Azure Database, etc.)
# Example: jdbc:postgresql://prod-db-instance.xxxxx.us-east-1.rds.amazonaws.com:5432/gmb_db
MONGODB_URI=mongodb://your-production-mongodb-cluster/gmbai
MONGODB_DATABASE=gmb_production

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# CRITICAL: Generate a cryptographically secure JWT_SECRET
# DO NOT use default values in production
# Generate with: openssl rand -base64 32
GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-production-google-client-secret
JWT_SECRET=your-cryptographically-secure-jwt-secret-minimum-32-characters

# ==========================================
# AI & THIRD-PARTY APIs
# ==========================================
# Use production API keys
ANTHROPIC_API_KEY=sk-ant-your-production-anthropic-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
RAZORPAY_KEY_ID=rzp_live_your_production_key_id
RAZORPAY_KEY_SECRET=your_production_razorpay_secret

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
# Use production email service credentials
# Recommendations: AWS SES, SendGrid, Mailgun, or similar
SPRING_MAIL_HOST=your-production-smtp-host
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=noreply@your-domain.com
SPRING_MAIL_PASSWORD=your-secure-email-password

# ==========================================
# APPLICATION URLs
# ==========================================
# Production domain with HTTPS
FRONTEND_URL=https://your-production-domain.com
BACKEND_URL=https://api.your-production-domain.com
NEXT_PUBLIC_API_URL=https://api.your-production-domain.com

# ==========================================
# MONITORING & LOGGING
# ==========================================
# Enable detailed monitoring in production
LOG_LEVEL=INFO
ENABLE_PROMETHEUS_METRICS=true
ENABLE_ERROR_TRACKING=true
ERROR_TRACKING_DSN=https://your-sentry-dsn-here

# ==========================================
# DEPLOYMENT NOTES
# ==========================================
# 1. Store secrets in your cloud provider's secret management service
# 2. Use environment-specific CI/CD pipelines
# 3. Enable SSL/TLS for all endpoints
# 4. Set up proper backup strategies for databases
# 5. Configure auto-scaling and load balancing
# 6. Enable CloudWatch/Stackdriver logging
# 7. Set up database read replicas for high availability
# 8. Use CDN for static assets (CloudFront, Cloudflare)
# 9. Enable rate limiting and DDoS protection
# 10. Set up monitoring alerts for critical metrics
