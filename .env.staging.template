# ==========================================
# GMB AI Manager - STAGING Environment
# ==========================================
# This template is for staging/QA deployments.
# Use real credentials that match production but with staging accounts.

# ==========================================
# GENERAL CONFIGURATION
# ==========================================
SPRING_PROFILES_ACTIVE=staging
NODE_ENV=production
GOOGLE_API_MODE=PRODUCTION

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Use staging database (separate from production)
MONGODB_URI=mongodb://staging-mongodb-cluster/gmbai
MONGODB_DATABASE=gmb_staging

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# Use staging OAuth credentials
GOOGLE_CLIENT_ID=your-staging-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-staging-google-client-secret
JWT_SECRET=your-staging-jwt-secret-minimum-32-characters

# ==========================================
# AI & THIRD-PARTY APIs
# ==========================================
# Use staging/test API keys
ANTHROPIC_API_KEY=sk-ant-your-staging-anthropic-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
RAZORPAY_KEY_ID=rzp_test_your_staging_key_id
RAZORPAY_KEY_SECRET=your_staging_razorpay_secret

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
# Use staging email service
SPRING_MAIL_HOST=smtp.staging-mail-server.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=staging-noreply@your-domain.com
SPRING_MAIL_PASSWORD=your-staging-email-password

# ==========================================
# APPLICATION URLs
# ==========================================
# Staging domain (can be subdomain or separate domain)
FRONTEND_URL=https://staging.your-domain.com
BACKEND_URL=https://api-staging.your-domain.com
NEXT_PUBLIC_API_URL=https://api-staging.your-domain.com

# ==========================================
# MONITORING & LOGGING
# ==========================================
# Enable verbose logging for debugging
LOG_LEVEL=DEBUG
ENABLE_PROMETHEUS_METRICS=true
ENABLE_ERROR_TRACKING=true
ERROR_TRACKING_DSN=https://your-staging-sentry-dsn-here
